    "bun": "^1.0.2",
    "cheerio": "^1.0.0-rc.12",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "googleapis": "^133.0.0",
    "handlebars": "^4.7.8",
    "instagram-private-api": "^1.45.3",
    "joi": "^17.9.2",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.29.4",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.3.2",
    "nodemailer": "^6.9.8",
    "npm": "^10.7.0",
    "passport": "^0.7.0",
