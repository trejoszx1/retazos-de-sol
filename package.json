    "sequelize": "^6.31.1",
    "short-uuid": "^4.2.2"
  },
  "devDependencies": {
    "eslint": "^8.39.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-prettier": "^4.2.1",
    "madge": "^6.1.0",
    "nodemon": "^3.0.1",
    "prettier": "^2.8.8",
    "sequelize-cli": "^6.6.1"
